# Local development environment. Copy to `.env` and adjust as needed.
# Never commit `.env`.

# Postgres (dev database, created by the postgres service in compose.yaml)
DATABASE_URL=postgresql://foliocraft:foliocraft@localhost:5432/foliocraft
# Postgres (integration-test database, created by scripts/init-test-db.sql)
DATABASE_TEST_URL=postgresql://foliocraft:foliocraft@localhost:5432/foliocraft_test

# Better Auth (secret must be at least 32 characters)
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth (optional until the auth task wires it up)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# SMTP (Mailpit in local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=FolioCraft <no-reply@foliocraft.local>

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
