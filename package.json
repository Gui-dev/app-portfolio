{
	"name": "foliocraft",
	"version": "0.1.0",
	"private": true,
	"description": "FolioCraft — a Next.js portfolio generator",
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"seed": "tsx scripts/seed.ts",
		"infra:up": "podman compose up -d",
		"infra:down": "podman compose down"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lefthook"
		]
	},
	"dependencies": {
		"@hookform/resolvers": "^7.0.7",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tabs": "^1.2.1",
		"better-auth": "^1.7.25",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"lucide-react": "^1.74.0",
		"next": "^15.5.29",
		"nodemailer": "^10.6.0",
		"postgres": "^4.1.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.92.0",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/postcss": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.12",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"dotenv": "^18.0.10",
		"drizzle-kit": "^0.31.11",
		"jsdom": "^31.0.1",
		"lefthook": "^2.2.2",
		"msw": "^3.0.6",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^5.1.0"
	}
}
